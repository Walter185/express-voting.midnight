# Copy to .env.preview and fill locally. NEVER commit .env.preview.

# 24-word mnemonic controlled by the platform wallet on Midnight Preview.
MIDNIGHT_PREVIEW_MNEMONIC='word1 word2 ... word24'

# Existing Express Voting contract on Preview (64 hex chars).
PREVIEW_CONTRACT_ADDRESS='replace-with-preview-contract-address'

# 32-byte private admin secret in hexadecimal (64 hex chars).
MIDNIGHT_ADMIN_SECRET='replace-with-64-hex-characters'

# Firebase Admin authorization. Only this email can use /admin/*.
FIREBASE_ADMIN_EMAIL='admin@example.com'
GOOGLE_APPLICATION_CREDENTIALS='/absolute/path/to/private/firebase-admin.json'

# Local proof server used while transactions are proven for Preview.
MIDNIGHT_PROOF_SERVER='http://127.0.0.1:6300'

# Optional: fail/restart a stuck wallet transaction worker after 2 minutes.
MIDNIGHT_TX_TIMEOUT_MS='120000'
